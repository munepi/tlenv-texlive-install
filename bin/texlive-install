#!/usr/bin/env bash
#
# Usage: texlive-install [-dvk] <definition> <prefix> [-- <install-tl-args...>]
#        texlive-install {--list|--definitions}
#        texlive-install --resolve <version>
#        texlive-install --version
#
#   -l, --list      List latest stable releases for each TeX Live
#   --definitions   List all local definitions, including outdated ones
#   --resolve       Print the latest stable definition name matching a version prefix
#   --version       Show version of texlive-install
#
#   -d, --dir       Install the TeX Live in <prefix>/<definition> instead of <prefix>
#   -v, --verbose   Verbose mode: forward all install output to stdout/stderr
#   -k, --keep      Do not remove source tree after installation
#   -4, --ipv4      Resolve names to IPv4 addresses only
#   -6, --ipv6      Resolve names to IPv6 addresses only
#

TEXLIVE_INSTALL_VERSION="20260822"

OLDIFS="$IFS"

# Have shell functions inherit the ERR trap.
set -E

# Some functions need to be able to write to the original process stderr
# stream, since fd 2 would often have been redirected elsewhere. To enable
# this, texlive-install initializes two additional file descriptors:
#
#  3: the original stderr
#  4: the log file
exec 3<&2

lib() {
  parse_options() {
    OPTIONS=()
    ARGUMENTS=()
    EXTRA_ARGUMENTS=()
    local arg option index

    while [ $# -gt 0 ]; do
      arg="$1"
      if [ "$arg" == "--" ]; then
        shift 1
        break
      elif [ "${arg:0:1}" = "-" ]; then
        if [ "${arg:1:1}" = "-" ]; then
          OPTIONS[${#OPTIONS[*]}]="${arg:2}"
        else
          index=1
          while option="${arg:$index:1}"; do
            [ -n "$option" ] || break
            OPTIONS[${#OPTIONS[*]}]="$option"
            index=$((index+1))
          done
        fi
        shift 1
      else
        ARGUMENTS[${#ARGUMENTS[*]}]="$arg"
        shift 1
      fi
    done

    EXTRA_ARGUMENTS=("$@")
  }

  if [ "$1" == "--${FUNCNAME[0]}" ]; then
    declare -f "${FUNCNAME[0]}"
    echo "${FUNCNAME[0]} \"\$1\";"
    exit
  fi
}
lib "$1"


resolve_link() {
  $(type -p greadlink readlink | head -1) "$1"
}

abs_dirname() {
  local path="$1"
  local cwd
  cwd="$(pwd || true)"

  while [ -n "$path" ]; do
    cd "${path%/*}" || return 1
    local name="${path##*/}"
    path="$(resolve_link "$name" || true)"
  done

  pwd
  cd "$cwd" || return 1
}

capitalize() {
  # shellcheck disable=SC2018,SC2019
  printf "%s" "$1" | tr 'a-z' 'A-Z'
}

sanitize() {
  printf "%s" "$1" | sed "s/[^A-Za-z0-9.-]/_/g; s/__*/_/g"
}

colorize() {
  if [[ -n $CLICOLOR_FORCE || ( -z $NO_COLOR && -t 1 ) ]]; then
    printf "\e[%sm%s\e[m" "$1" "$2"
  else
    printf "%s" "$2"
  fi
}

print_command() {
  local arg
  for arg; do
    [ "${#TMPDIR}" -le 1 ] || arg="${arg//$TMP\//\$TMPDIR/}"
    [ "${#HOME}" -le 1 ] || arg="${arg//$HOME\//\$HOME/}"
    case "$arg" in
    *\'* | *\$* )
      printf ' "%s"' "$arg" ;;
    *' '* )
      printf " '%s'" "$arg" ;;
    * )
      printf ' %s' "$arg" ;;
    esac
  done
  printf '\n'
}

# Log the full invocation of an external command.
log_command() {
  local msg
  msg="->$(print_command "$@")"

  colorize 36 "$msg"
  echo
  [ -n "$VERBOSE" ] || printf "%s\n" "$msg" >&4

  local status=0
  "$@" || status="$?"
  if [ "$status" -ne 0 ]; then
    echo "external command failed with status $status" >&4
  fi
  return "$status"
}

# Log the full invocation of an external command and capture its output.
capture_command() {
  local msg
  msg="->$(print_command "$@")"

  colorize 36 "$msg"
  echo

  # In verbose mode, connect the subcommand to original stdout & stderr.
  local cmd_stdout=1
  local cmd_stderr=3
  if [ -z "$VERBOSE" ]; then
    printf "%s\n" "$msg" >&4
    # In normal mode, redirect all subcommand output to LOG_PATH.
    cmd_stdout=4
    cmd_stderr=4
  fi

  local status=0
  # shellcheck disable=SC2261
  "$@" 2>&$cmd_stderr >&$cmd_stdout || status="$?"
  if [ "$status" -ne 0 ]; then
    echo "external command failed with status $status" >&4
  fi
  return "$status"
}

log_info() {
  colorize 1 "==> $*"
  echo
  [ -n "$VERBOSE" ] || echo "==> $*" >&4
}

log_notice() {
  echo "texlive-install: $*"
}

os_information() {
  if type -p lsb_release >/dev/null; then
    lsb_release -sir | xargs echo
  elif type -p sw_vers >/dev/null; then
    echo "$(sw_vers -productName) $(sw_vers -productVersion)"
  elif [ -r /etc/os-release ]; then
    # shellcheck disable=SC1091
    source /etc/os-release
    # shellcheck disable=SC2153
    echo "$NAME $VERSION_ID"
  else
    local os
    os="$(cat /etc/{centos,redhat,fedora,system}-release /etc/debian_version 2>/dev/null | head -1)"
    echo "${os:-$(uname -sr)}"
  fi
}

is_mac() {
  [ "$(uname -s)" = "Darwin" ] || return 1
  [ $# -eq 0 ] || [ "$(osx_version)" -ge "$1" ]
}

#  9.1  -> 901
# 10.9  -> 1009
# 10.10 -> 1010
osx_version() {
  local ver
  IFS=. read -d "" -r -a ver <<<"$(sw_vers -productVersion)" || true
  IFS="$OLDIFS"
  echo $(( ver[0]*100 + ver[1] ))
}

build_failed() {
  { echo
    colorize '31;1' "BUILD FAILED"
    echo " ($(os_information) on $(uname -m) using $(version))"
    echo

    if ! rmdir "${BUILD_PATH}" 2>/dev/null; then
      echo "You can inspect the build directory at ${BUILD_PATH}"

      if [ -n "$(head -1 "$LOG_PATH" 2>/dev/null)" ]; then
        colorize 33 "See the full build log at ${LOG_PATH}"
        printf "\n"
      fi
    fi
  } >&3
  exit 1
}

num_cpu_cores() {
  local num
  case "$(uname -s)" in
  Darwin | *BSD )
    num="$(sysctl -n hw.ncpu 2>/dev/null || true)"
    ;;
  SunOS )
    num="$(getconf NPROCESSORS_ONLN 2>/dev/null || true)"
    ;;
  * )
    num="$({ getconf _NPROCESSORS_ONLN ||
             grep -c ^processor /proc/cpuinfo; } 2>/dev/null)"
    num="${num#0}"
    ;;
  esac
  echo "${num:-2}"
}

# TeX Live releases that ship no arm64 macOS binaries. On Apple silicon these
# have to be installed with `install-tl -force-platform x86_64-darwin' and run
# through Rosetta 2; auto-detection would otherwise pick a platform that is not
# present in those repositories. Returns nothing when the default applies.
default_texlive_install_platform() {
  local texlive_install_version="$1"

  [ "$(uname -s)" = "Darwin" ] || return 0
  [ "$(uname -m)" = "arm64" ] || return 0

  case "$texlive_install_version" in
  201[0-2] | 201[7-9] )
    echo "x86_64-darwin"
    ;;
  esac
}

install_texlive() {
  local texlive_install_version="$1"
  local texlive_install_tlnet="$2"
  local texlive_install_tl_unx_tarball="$3"   ##<= install-tl-unx.tar.gz#<sha256 or sha512>
  local texlive_install_tl_unx
  local texlive_arch
  local -a install_tl_opts
  shift 3

  # shellcheck disable=SC2164
  pushd "$BUILD_PATH" >/dev/null
  echo "cd $PWD" >&4

  if [ -n "${TEXLIVE_INSTALL_TLNET}" ]; then
    texlive_install_tlnet="${TEXLIVE_INSTALL_TLNET}"
  fi
  texlive_install_tl_unx="${texlive_install_tlnet}${texlive_install_tl_unx_tarball}"
  fetch_tarball install-tl-unx "$texlive_install_tl_unx"

  if [ -z "${TEXLIVE_INSTALL_PLATFORM}" ]; then
    TEXLIVE_INSTALL_PLATFORM="$(default_texlive_install_platform "${texlive_install_version}")"
    [ -z "${TEXLIVE_INSTALL_PLATFORM}" ] ||
      log_info "TeX Live ${texlive_install_version} has no arm64 macOS binaries; forcing ${TEXLIVE_INSTALL_PLATFORM}"
  fi

  if [ -n "${TEXLIVE_INSTALL_PLATFORM}" ]; then
    texlive_arch="${TEXLIVE_INSTALL_PLATFORM}"
    install_tl_opts=(-force-platform "${TEXLIVE_INSTALL_PLATFORM}")
  else
    texlive_arch="$(install-tl-unx/install-tl -print-platform)"
  fi
  if [[ $texlive_arch == *unknown* ]]; then
    { echo
      echo "${texlive_arch}: not a supported platform"
      echo "Please set \$TEXLIVE_INSTALL_PLATFORM instead of auto-detecting the current platform."
      echo
    } >&2
    return 1
  fi

  if [ -f "${PREFIX_PATH}/bin/${texlive_arch}/tlmgr" ]; then
    # shellcheck disable=SC2164
    popd >/dev/null
    log_info "Skipped TeX Live installation"
    return 0
  fi

  printf "%s\n" \
         "TEXDIR          ${PREFIX_PATH}"              \
         "TEXMFLOCAL      ${PREFIX_PATH}/texmf-local"  \
         "TEXMFSYSVAR     ${PREFIX_PATH}/texmf-var"    \
         "TEXMFSYSCONFIG  ${PREFIX_PATH}/texmf-config" \
         "TEXMFHOME       ${PREFIX_PATH}/texmf-local"  \
         "TEXMFVAR        ${PREFIX_PATH}/texmf-var"    \
         "TEXMFCONFIG     ${PREFIX_PATH}/texmf-config" \
         "selected_scheme scheme-basic" \
         "binary_${texlive_arch}  1" \
         "option_adjustrepo       0" \
         "option_autobackup       0" \
         "option_doc              0" \
         "option_src              0" \
         > ./install-tl-unx/texlive.profile

  log_info "Installing TeX Live ${texlive_install_version}..."
  capture_command ./install-tl-unx/install-tl \
                  -profile ./install-tl-unx/texlive.profile \
                  -repository "${texlive_install_tlnet}" \
                  "${install_tl_opts[@]}" "$@" "${TEXLIVE_INSTALL_OPTS_ARRAY[@]}"

  ## remove the symbolic link bin/${texlive_arch}/man
  rm -f "${PREFIX_PATH}/bin/${texlive_arch}/man"

  ## post setup texmf.cnf
  cp -a "${PREFIX_PATH}/texmf.cnf" "${PREFIX_PATH}/texmf.cnf.distro"
  if is_mac; then
  cat<<__CNF__ >>"${PREFIX_PATH}/texmf.cnf"

% OSFONTDIR is to provide a convenient hook for allowing TeX to find
% fonts installed on the system (outside of TeX).  An empty default
% value would add "//" to the search paths, so we give it a dummy value.
%default: OSFONTDIR = /please/set/osfontdir/in/the/environment
OSFONTDIR = /System/Library/Fonts//;/Library/Fonts//;/System/Library/AssetsV2/com_apple_MobileAsset_Font{6,7}//;/System/Library/Assets/com_apple_MobileAsset_Font{3,4,5}//;~/Library/Fonts//
__CNF__
  fi
  cat<<__CNF__ >>"${PREFIX_PATH}/texmf.cnf"

% This variable is specific to Unix, to fall back to case-insensitive
% search in non-system directories if there is no exact match. It is
% enabled by default in texmf.cnf, but not enabled by default at
% compile-time.
%
%default: texmf_casefold_search = 1
texmf_casefold_search = 0

% Words of font info for TeX (total size of all TFM files, approximately).
% Must be >= 20000 and <= 147483647 (without tex.ch changes).
%default: font_mem_size = 8000000
font_mem_size = 16000000

% Total number of fonts. Must be >= 50 and <= 9000 (without tex.ch changes).
%default: font_max = 9000
font_max = 18000

% BibTeX only (max_strings also determines hash_size and hash_prime).
%default: ent_str_size =  250
ent_str_size=2000

% It's probably inadvisable to change these. At any rate, we must have:
% 45 < error_line      < 255;
% 30 < half_error_line < error_line - 15;
% 60 <= max_print_line;
% These apply to TeX, Metafont, and MetaPost.
error_line=254
half_error_line=238
max_print_line=1048576

% (up)bibtex requires max_print_line < buf_size (=200000); restore the default for BibTeX family only
max_print_line.bibtex   = 79
max_print_line.pbibtex  = 79
max_print_line.upbibtex = 79
max_print_line.bibtexu  = 79
__CNF__

  # shellcheck disable=SC2164
  popd >/dev/null
  log_info "Installed ${texlive_install_version} to ${PREFIX_PATH}"
}

install_texlive_package() {
  local arch
  arch="$(find "${PREFIX_PATH}/bin/"* -maxdepth 1 -type d | sed "s,.*/,,")"

  capture_command "${PREFIX_PATH}/bin/${arch}/tlmgr" install "$@"
  log_info "Installed $(echo "$@" | sed "s,--file,,g") to ${PREFIX_PATH}"
}

compute_sha2() {
  local output
  if type shasum &>/dev/null; then
    output="$(shasum -a 256 -b)" || return 1
    echo "${output% *}"
  elif type openssl &>/dev/null; then
    output="$(openssl dgst -sha256 2>/dev/null)" || return 1
    echo "${output##* }"
  elif type sha256sum &>/dev/null; then
    output="$(sha256sum -b)" || return 1
    echo "${output%% *}"
  else
    return 1
  fi
}

compute_sha5() {
  local output
  if type shasum &>/dev/null; then
    output="$(shasum -a 512 -b)" || return 1
    echo "${output% *}"
  elif type openssl &>/dev/null; then
    output="$(openssl dgst -sha512 2>/dev/null)" || return 1
    echo "${output##* }"
  elif type sha512sum &>/dev/null; then
    output="$(sha512sum -b)" || return 1
    echo "${output%% *}"
  else
    return 1
  fi
}

compute_md5() {
  local output
  if type md5 &>/dev/null; then
    md5 -q
  elif type openssl &>/dev/null; then
    output="$(openssl md5)" || return 1
    echo "${output##* }"
  elif type md5sum &>/dev/null; then
    output="$(md5sum -b)" || return 1
    echo "${output%% *}"
  else
    return 1
  fi
}

has_checksum_support() {
  local checksum_command="$1"
  local has_checksum_var="HAS_CHECKSUM_SUPPORT_${checksum_command}"

  if [ -z "${!has_checksum_var+defined}" ]; then
    if "$checksum_command" <<<"test" >/dev/null; then
      printf -v "$has_checksum_var" 0 # success
    else
      printf -v "$has_checksum_var" 1 # error
    fi
  fi
  return "${!has_checksum_var}"
}

verify_checksum() {
  local checksum_command
  local filename="$1"
  local expected_checksum
  expected_checksum="$(tr 'A-F' 'a-f' <<<"$2")"

  # If the specified filename doesn't exist, return success
  [ -e "$filename" ] || return 0

  case "${#expected_checksum}" in
  0) return 0 ;; # empty checksum; return success
  32) checksum_command="compute_md5" ;;
  64) checksum_command="compute_sha2" ;;
  128) checksum_command="compute_sha5" ;;
  *)
    { echo
      echo "unexpected checksum length: ${#expected_checksum} (${expected_checksum})"
      echo "expected 0 (no checksum), 32 (MD5), 64 (SHA2-256), or 128 (SHA2-512)"
      echo
    } >&2
    return 1 ;;
  esac

  # If chosen provided checksum algorithm isn't supported, return success
  has_checksum_support "$checksum_command" || return 0

  # If the computed checksum is empty, return failure
  local computed_checksum
  computed_checksum="$("$checksum_command" < "$filename" | tr 'A-F' 'a-f')"
  [ -n "$computed_checksum" ] || return 1

  if [ "$expected_checksum" != "$computed_checksum" ]; then
    { echo
      echo "checksum mismatch: ${filename} (file is corrupt)"
      echo "expected $expected_checksum, got $computed_checksum"
      echo
    } >&2
    return 1
  fi
}

http() {
  local method="$1"
  [ -n "$2" ] || return 1
  shift 1

  TEXLIVE_INSTALL_HTTP_CLIENT="${TEXLIVE_INSTALL_HTTP_CLIENT:-$(detect_http_client)}"
  [ -n "$TEXLIVE_INSTALL_HTTP_CLIENT" ] || return 1

  # http_get_curl, http_get_wget, etc.
  "http_${method}_${TEXLIVE_INSTALL_HTTP_CLIENT}" "$@"
}

detect_http_client() {
  local client
  for client in aria2c curl wget; do
    if type "$client" &>/dev/null; then
      echo "$client"
      return
    fi
  done
  echo "error: install \`curl\`, \`wget\`, or \`aria2c\` to download packages" >&2
  return 1
}

http_head_aria2c() {
  # shellcheck disable=SC2086
  aria2c --dry-run --no-conf=true $ARIA2_OPTS "$1" >/dev/null
}

http_get_aria2c() {
  local destfile="$2"
  if [[ $destfile == /* ]]; then
    # the "-o" option to aria2c cannot be an absolute path, but we can achieve that with "--dir"
    # shellcheck disable=SC2086
    log_command aria2c --allow-overwrite=true --no-conf=true --console-log-level=warn --stderr $ARIA2_OPTS --dir "${destfile%/*}" -o "${destfile##*/}" "$1" 2>&3
  else
    # shellcheck disable=SC2086
    log_command aria2c --allow-overwrite=true --no-conf=true --console-log-level=warn --stderr $ARIA2_OPTS -o "$destfile" "$1" 2>&3
  fi
}

http_head_curl() {
  # shellcheck disable=SC2086
  curl -qsILf $CURL_OPTS "$1" >/dev/null
}

http_get_curl() {
  # shellcheck disable=SC2086
  log_command curl -q -fL $CURL_OPTS -o "$2" "$1" 2>&3
}

http_head_wget() {
  # shellcheck disable=SC2086
  wget -q --spider $WGET_OPTS "$1" >/dev/null
}

http_get_wget() {
  # shellcheck disable=SC2086
  log_command wget $WGET_OPTS -O "$2" "$1" 2>&3
}

fetch_tarball() {
  local package_name="$1"
  local package_url="$2"
  local mirror_url
  local checksum
  local extracted_dir

  if [ "$package_url" != "${package_url/\#}" ]; then
    checksum="${package_url#*#}"
    package_url="${package_url%%#*}"

    # Unlike ruby-build, texlive-install has no default mirror: the tlnet
    # repository to install from is part of each definition and can be
    # overridden with $TEXLIVE_INSTALL_TLNET. $TEXLIVE_INSTALL_MIRROR_URL, if
    # set, is expected to host `install-tl-unx.tar.gz' under the same name.
    if [ -n "$TEXLIVE_INSTALL_MIRROR_URL" ]; then
      mirror_url="${TEXLIVE_INSTALL_MIRROR_URL}/${package_url##*/}"
    elif [ -n "$TEXLIVE_INSTALL_MIRROR_PACKAGE_URL" ]; then
      mirror_url="$TEXLIVE_INSTALL_MIRROR_PACKAGE_URL"
    fi
  fi

  local tar_args="xzf"
  local package_filename="${package_name}.tar.gz"

  if [ "$package_url" != "${package_url%bz2}" ]; then
    if ! type -p bzip2 >/dev/null; then
      echo "warning: bzip2 not found; consider installing the \`bzip2\` package" >&2
    fi
    package_filename="${package_filename%.gz}.bz2"
    tar_args="${tar_args/z/j}"
  fi

  if ! reuse_existing_tarball "$package_filename" "$checksum"; then
    local tarball_filename
    tarball_filename="$(basename "$package_url")"
    log_info "Downloading ${tarball_filename}..."
    # shellcheck disable=SC2015
    http head "$mirror_url" &&
    download_tarball "$mirror_url" "$package_filename" "$checksum" ||
    download_tarball "$package_url" "$package_filename" "$checksum"
  fi

  log_command tar "$tar_args" "$package_filename" >/dev/null

  if [ ! -d "$package_name" ]; then
    extracted_dir="$(find_extracted_directory)"
    mv "$extracted_dir" "$package_name"
  fi

  [ -n "$KEEP_BUILD_PATH" ] || rm -f "$package_filename"
}

find_extracted_directory() {
  for f in *; do
    if [ -d "$f" ]; then
      echo "$f"
      return
    fi
  done
  echo "Extracted directory not found" >&2
  return 1
}

reuse_existing_tarball() {
  local package_filename="$1"
  local checksum="$2"

  # Reuse existing file in build location
  if [ -e "$package_filename" ] && verify_checksum "$package_filename" "$checksum"; then
    return 0
  fi

  # Reuse previously downloaded file in cache location
  [ -n "$TEXLIVE_INSTALL_CACHE_PATH" ] || return 1
  local cached_package_filename="${TEXLIVE_INSTALL_CACHE_PATH}/$package_filename"

  [ -e "$cached_package_filename" ] || return 1
  verify_checksum "$cached_package_filename" "$checksum" || return 1
  ln -s "$cached_package_filename" "$package_filename" || return 1
}

download_tarball() {
  local package_url="$1"
  [ -n "$package_url" ] || return 1

  local package_filename="$2"
  local checksum="$3"

  if http get "$package_url" "$package_filename"; then
    verify_checksum "$package_filename" "$checksum" || return 1
  else
    echo "error: failed to download $package_filename" >&2
    return 1
  fi

  if [ -n "$TEXLIVE_INSTALL_CACHE_PATH" ]; then
    local cached_package_filename="${TEXLIVE_INSTALL_CACHE_PATH}/$package_filename"
    mv "$package_filename" "$cached_package_filename"
    ln -s "$cached_package_filename" "$package_filename"
  fi
}

version() {
  local git_revision
  # Read the revision from git if the remote points to "texlive-install" repository
  if GIT_DIR="$TEXLIVE_INSTALL_INSTALL_PREFIX/.git" git remote -v 2>/dev/null | grep -q /texlive-install; then
    git_revision="$(GIT_DIR="$TEXLIVE_INSTALL_INSTALL_PREFIX/.git" git describe --tags HEAD 2>/dev/null || true)"
    git_revision="${git_revision#v}"
  fi
  echo "texlive-install ${git_revision:-$TEXLIVE_INSTALL_VERSION}"
}

usage() {
  sed -ne '/^#/!q;s/.\{1,2\}//;1,2d;p' < "$0"
  [ -z "$1" ] || exit "$1"
}

# list all versions
list_definitions() {
  { for DEFINITION_DIR in "${TEXLIVE_INSTALL_DEFINITIONS[@]}"; do
      [ -d "$DEFINITION_DIR" ] && ls "$DEFINITION_DIR"
    done
  } | sort_versions | uniq
}

# list only latest stable versions excluding pretest, RC, preview, dev and EoL'ed
list_maintained_versions() {
  { for DEFINITION_DIR in "${TEXLIVE_INSTALL_DEFINITIONS[@]}"; do
      [ -d "$DEFINITION_DIR" ] && \
        grep -L -e warn_eol "$DEFINITION_DIR"/* 2>/dev/null | \
        sed 's|.*/||' | \
        grep -v -e '^pretest$' -e '-pretest$' \
                -e '-rc[0-9]*$' -e '-preview[0-9]*$' -e '-dev$'
    done
  } | extract_latest_versions | sort_versions | uniq
}

# resolve a version prefix to the exact version name for which exists a
# definition file. Example: "langjapanese" => "langjapanese-2026"
resolve_version() {
  local version="$1"

  # Look for an exact match first.
  for DEFINITION_DIR in "${TEXLIVE_INSTALL_DEFINITIONS[@]}"; do
    if [ -f "${DEFINITION_DIR}/${version}" ]; then
      echo "$version"
      return 0
    fi
  done

  local grep_pattern="${version%.}"
  grep_pattern="$(tr 'A-Z' 'a-z' <<<"${grep_pattern//./\\.}")"

  version=$(list_definitions | \
    grep -e "^${grep_pattern}[-.]" | \
    grep -v -e '^pretest$' -e '-pretest$' \
            -e '-rc[0-9]*$' -e '-preview[0-9]*$' -e '-dev$' | \
    tail -n 1)

  [ -n "$version" ] || return 1
  echo "$version"
}

extract_latest_versions() {
  # Group definitions into series by removing the digits from their names
  # ("2026" => "", "langjapanese-2026" => "langjapanese-", "current" =>
  # "current") and print only the latest definition of each series. The input
  # has to be sorted first so that the last definition seen of a series is
  # also its latest one.
  sort_versions | awk '
    { series = $0; gsub(/[0-9]+/, "", series); latest[series] = $0 }
    END { for (series in latest) { print latest[series] } }'
}

sort_versions() {
  sed 'h; s/[-]/./g; s/.p\([[:digit:]]\)/.z.\1/; s/$/.z/; G; s/\n/ /' | \
    LC_ALL=C sort -t. -k 1,1 -k 2,2n -k 3,3n -k 4,4n -k 5,5n | awk '{print $2}'
}


unset VERBOSE
unset KEEP_BUILD_PATH
unset IPV4
unset IPV6
unset EARLY_EXIT
unset APPEND_DEFINITION_TO_PREFIX

TEXLIVE_INSTALL_INSTALL_PREFIX="$(abs_dirname "$0")/.."

# shellcheck disable=SC2206
IFS=: TEXLIVE_INSTALL_DEFINITIONS=($TEXLIVE_INSTALL_DEFINITIONS ${TEXLIVE_INSTALL_ROOT:-$TEXLIVE_INSTALL_INSTALL_PREFIX}/share/texlive-install)
IFS="$OLDIFS"

parse_options "$@"

for option in "${OPTIONS[@]}"; do
  case "$option" in
  "h" | "help" )
    EARLY_EXIT=help
    ;;
  "definitions" )
    EARLY_EXIT=list_definitions
    ;;
  "l" | "list")
    EARLY_EXIT=list_maintained_versions
    ;;
  "resolve")
    if [ "${#ARGUMENTS[*]}" -eq 1 ]; then
      EARLY_EXIT=resolve_version
    else
      echo "texlive-install: '--resolve' needs an argument" >&2
      EARLY_EXIT=usage_error
    fi
    ;;
  "d" | "dir")
    APPEND_DEFINITION_TO_PREFIX=true
    ;;
  "k" | "keep" )
    KEEP_BUILD_PATH=true
    ;;
  "v" | "verbose" )
    VERBOSE=true
    ;;
  "4" | "ipv4")
    IPV4=true
    ;;
  "6" | "ipv6")
    IPV6=true
    ;;
  "version" )
    EARLY_EXIT=version
    ;;
  * )
    printf "texlive-install: invalid flag '%s'\n" "$option" >&2
    EARLY_EXIT=usage_error
    ;;
  esac
done

DEFINITION_PATH="${ARGUMENTS[0]}"
PREFIX_PATH="${ARGUMENTS[1]}"

if [ -z "$EARLY_EXIT" ] && [ -z "$DEFINITION_PATH" ]; then
  echo "texlive-install: missing definition argument" >&2
  EARLY_EXIT=usage_error
fi

if [ -z "$EARLY_EXIT" ] && [ -z "$PREFIX_PATH" ]; then
  echo "texlive-install: missing prefix argument" >&2
  EARLY_EXIT=usage_error
fi

if [ "${#ARGUMENTS[@]}" -gt 2 ]; then
  echo "texlive-install: expected at most 2 arguments, got [${ARGUMENTS[*]}]" >&2
  EARLY_EXIT=usage_error
fi

# Extra arguments after `--' are passed through to `install-tl'.
if [ "${#EXTRA_ARGUMENTS[@]}" -gt 0 ]; then
  TEXLIVE_INSTALL_OPTS_ARRAY=("${EXTRA_ARGUMENTS[@]}")
fi

if [[ "$APPEND_DEFINITION_TO_PREFIX" = "true" && -p "$DEFINITION_PATH" ]]; then
  echo "texlive-install: using named pipes in combination with \`--dir' is not possible" >&2
  EARLY_EXIT=usage_error
fi

case "$EARLY_EXIT" in
help )
  version
  echo
  usage 0
  ;;
version | list_definitions | list_maintained_versions )
  "$EARLY_EXIT"
  exit 0
  ;;
resolve_version )
  resolve_version "${ARGUMENTS[0]}" || exit 1
  exit 0
  ;;
usage_error )
  echo >&2
  usage 1 >&2
  ;;
'' )
  ;;
* )
  echo "unimplemented EARLY_EXIT: $EARLY_EXIT" >&2
  exit 1
  ;;
esac

# expand the <definition> argument to full path of the definition file
if [[ ! -f "$DEFINITION_PATH" && ! -p "$DEFINITION_PATH" ]]; then
  if ! VERSION_NAME="$(resolve_version "$DEFINITION_PATH")"; then
    echo "texlive-install: definition not found: ${DEFINITION_PATH}" >&2
    exit 2
  fi

  for DEFINITION_DIR in "${TEXLIVE_INSTALL_DEFINITIONS[@]}"; do
    if [ -f "${DEFINITION_DIR}/${VERSION_NAME}" ]; then
      DEFINITION_PATH="${DEFINITION_DIR}/${VERSION_NAME}"
      break
    fi
  done
fi

if [ "$APPEND_DEFINITION_TO_PREFIX" = "true" ]; then
  PREFIX_PATH="$PREFIX_PATH/$(basename "$DEFINITION_PATH")"
fi

# normalize the <prefix> argument
if [ "${PREFIX_PATH#/}" = "$PREFIX_PATH" ]; then
  PREFIX_PATH="${PWD}/${PREFIX_PATH}"
fi

if [ -z "$TMPDIR" ]; then
  TMP="/tmp"
else
  TMP="${TMPDIR%/}"
fi

# Check if TMPDIR is accessible and can hold executables.
tmp_executable="${TMP}/texlive-install-test.$$"
noexec=""
if mkdir -p "$TMP" && touch "$tmp_executable" 2>/dev/null; then
  cat > "$tmp_executable" <<-EOF
	#!${BASH}
	exit 0
	EOF
  chmod +x "$tmp_executable"
else
  echo "texlive-install: TMPDIR=$TMP is set to a non-accessible location" >&2
  exit 1
fi
"$tmp_executable" 2>/dev/null || noexec=1
rm -f "$tmp_executable"
if [ -n "$noexec" ]; then
  echo "texlive-install: TMPDIR=$TMP cannot hold executables (partition possibly mounted with \`noexec\`)" >&2
  exit 1
fi

if [ -n "$TEXLIVE_INSTALL_CACHE_PATH" ] && [ -d "$TEXLIVE_INSTALL_CACHE_PATH" ]; then
  TEXLIVE_INSTALL_CACHE_PATH="${TEXLIVE_INSTALL_CACHE_PATH%/}"
else
  unset TEXLIVE_INSTALL_CACHE_PATH
fi

if [ -n "$TEXLIVE_INSTALL_MIRROR_URL" ]; then
  TEXLIVE_INSTALL_MIRROR_URL="${TEXLIVE_INSTALL_MIRROR_URL%/}"
fi

if [ -n "$TEXLIVE_INSTALL_SKIP_MIRROR" ] || ! has_checksum_support compute_sha2; then
  unset TEXLIVE_INSTALL_MIRROR_URL TEXLIVE_INSTALL_MIRROR_PACKAGE_URL
fi

ARIA2_OPTS="${TEXLIVE_INSTALL_ARIA2_OPTS} ${IPV4+--disable-ipv6=true} ${IPV6+--disable-ipv6=false}"
CURL_OPTS="${TEXLIVE_INSTALL_CURL_OPTS} ${IPV4+--ipv4} ${IPV6+--ipv6}"
WGET_OPTS="${TEXLIVE_INSTALL_WGET_OPTS} ${IPV4+--inet4-only} ${IPV6+--inet6-only}"

SEED="$(date "+%Y%m%d%H%M%S").$$"
LOG_PATH="${TMP}/texlive-install.${SEED}.log"

if [ -z "$TEXLIVE_INSTALL_BUILD_PATH" ]; then
  BUILD_PATH="$(mktemp -d "${LOG_PATH%.log}.XXXXXX")"
else
  BUILD_PATH="$TEXLIVE_INSTALL_BUILD_PATH"
fi

if [ -n "$VERBOSE" ]; then
  # open the original stdout at fd 4
  exec 4<&1
else
  # open the log file at fd 4
  exec 4<> "$LOG_PATH"
fi

TEXLIVE_INSTALL_PLATFORM=${TEXLIVE_INSTALL_PLATFORM:-}
TEXLIVE_INSTALL_TLNET=${TEXLIVE_INSTALL_TLNET:-}

# If something goes wrong during installing, print error information to stderr.
trap build_failed ERR

# This is where the magic happens: execute commands from the definition
# file while in a temporary build directory. This will typically result in
# `install_texlive' running the TeX Live installer.
mkdir -p "$BUILD_PATH"
# shellcheck disable=SC1090
source "$DEFINITION_PATH"

# By default, the temporary build path is wiped after successful install.
[ -z "${KEEP_BUILD_PATH}" ] && rm -fr "$BUILD_PATH"
trap - ERR
